PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ferreteria_db
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# URL del frontend que va dentro del QR (debe abrirse desde el celular).
# Ej: http://192.168.1.50:5173  o  https://xxxx.trycloudflare.com
PUBLIC_FRONTEND_URL=

EMAIL_USER=
EMAIL_PASSWORD=

# WhatsApp: "consola" (solo muestra el mensaje en la terminal) o "twilio"
WHATSAPP_PROVIDER=consola
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034

# Cuenta de prueba ("Try out WhatsApp"): solo acepta plantillas de Twilio (ContentSid HX...).
# Marcadores: {cliente} {numero_orden} {estado_recepcion} {fecha} {total} {ciudad} {direccion} {comentario}
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARIABLES=
